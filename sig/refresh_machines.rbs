module RefreshMachines
  VERSION: String

  # Every instant (`now`, `Backoff#until`) and span (ages, policy windows,
  # `lead_for`, `retry_after`) is Integer nanoseconds. Arguments must be in
  # 0..2**64-1; a returned sum may be larger, it never wraps.
  type state = :fresh | :stale | :expired
  # Refusals: the call was not honoured and changed nothing. Every reason has
  # its own symbol; there is no catch-all.
  type refusal = :time_regressed | :rejected | :entries_full | :flights_full
               | :waiters_full | :exhausted | :stale

  # The scope (0..65_535) a lease, waiter or flight id was issued under: the
  # top 16 bits. Use it to route an id to the refresher that issued it.
  def self.scope_of: (Integer id) -> Integer

  class Policy < Data
    attr_reader fresh_for: Integer
    attr_reader stale_while_revalidate: Integer
    attr_reader stale_if_error: Integer
    def self.new: (Integer fresh_for, Integer stale_while_revalidate, Integer stale_if_error) -> Policy
                | (fresh_for: Integer, stale_while_revalidate: Integer, stale_if_error: Integer) -> Policy
    def state: (Integer age) -> state
    def while_revalidate?: (Integer age) -> bool
    def if_error?: (Integer age) -> bool
  end

  class Fresh < Data
    attr_reader age: Integer
    def self.new: (Integer age) -> Fresh
                | (age: Integer) -> Fresh
  end

  # Who refreshes a stale value that is being served.
  type revalidation = Lead | :in_flight | Backoff | Unavailable

  class Stale < Data
    attr_reader age: Integer
    attr_reader revalidation: revalidation
    def self.new: (Integer age, revalidation revalidation) -> Stale
                | (age: Integer, revalidation: revalidation) -> Stale
  end

  # Ids are Integers: lease ids, waiter ids and flight ids, all from the one
  # sequence of their refresher, so no two ids of a refresher are equal.
  class Fetch < Data
    attr_reader lease: Integer
    def self.new: (Integer lease) -> Fetch
                | (lease: Integer) -> Fetch
  end

  class Wait < Data
    attr_reader waiter: Integer
    attr_reader flight: Integer
    def self.new: (Integer waiter, Integer flight) -> Wait
                | (waiter: Integer, flight: Integer) -> Wait
  end

  class Lead < Data
    attr_reader lease: Integer
    def self.new: (Integer lease) -> Lead
                | (lease: Integer) -> Lead
  end

  class Backoff < Data
    attr_reader until: Integer
    def self.new: (Integer until_) -> Backoff
                | (until: Integer) -> Backoff
  end

  class Unavailable < Data
    # Why the refresh was not registered.
    type reason = :flights_full | :exhausted

    attr_reader refusal: reason
    def self.new: (reason refusal) -> Unavailable
                | (refusal: reason) -> Unavailable
  end

  class Notification < Data
    type outcome = :completed | :abandoned

    attr_reader waiter: Integer
    attr_reader flight: Integer
    attr_reader key: Integer
    attr_reader outcome: outcome
    def self.new: (Integer waiter, Integer flight, Integer key, outcome outcome) -> Notification
                | (waiter: Integer, flight: Integer, key: Integer, outcome: outcome) -> Notification
  end

  class Refresher
    CAPACITY: Integer
    FLIGHT_CAPACITY: Integer
    WAITER_CAPACITY: Integer

    # Scope zero.
    def self.new: () -> Refresher
    # `scope` is an Integer in 0..65_535, carried in the top 16 bits of every id.
    def self.with_scope: (Integer scope) -> Refresher
    # Empty, at time zero, the id sequence continuing after `issued` (a saved
    # `#issued`): the constructor for a restart. nil when `issued` is beyond
    # the sequence (more than 2**48 - 1).
    def self.resumed: (Integer scope, Integer issued) -> Refresher
    def scope: () -> Integer
    # Ids issued so far, of every kind (leases, waiter ids, flight ids, all
    # from one sequence): the count to save for `resumed`.
    def issued: () -> Integer
    # Honoured: Fresh, Stale, Fetch, Wait. Refused: :time_regressed, :rejected,
    # and, only when nothing is servable, :flights_full, :waiters_full, :exhausted.
    def decide: (Integer key, Integer now, Integer lead_for) -> (Fresh | Stale | Fetch | Wait | :time_regressed | :rejected | :flights_full | :waiters_full | :exhausted)
    # Honoured: :stored. Refused: :time_regressed, :stale, :entries_full.
    def store: (Integer lease, Integer now, Integer age, Policy policy) -> (:stored | :time_regressed | :stale | :entries_full)
    # Honoured: the age of the value that covers for the failure, or nil when
    # nothing does. Refused: :time_regressed, :stale.
    def fail: (Integer lease, Integer now, Integer retry_after) -> (Integer | nil | :time_regressed | :stale)
    # Honoured: :abandoned. Refused: :stale.
    def abandon: (Integer lease) -> (:abandoned | :stale)
    # Honoured: leases revoked. Refused: :time_regressed.
    def reap: (Integer now) -> (Integer | :time_regressed)
    # Honoured: :stored. Refused: :time_regressed, :entries_full.
    def put: (Integer key, Integer now, Integer age, Policy policy) -> (:stored | :time_regressed | :entries_full)
    # Honoured: :forgotten when there was metadata to drop, and the repeat
    # :not_held when the key had none (nothing changes). Never refuses.
    def forget: (Integer key) -> (:forgotten | :not_held)
    # Honoured: the swept keys. Refused: :time_regressed.
    def sweep: (Integer now, Integer max) -> (Array[Integer] | :time_regressed)
    # Honoured: :cancelled. Refused: :stale.
    def cancel: (Integer waiter) -> (:cancelled | :stale)
    # The oldest queued notification, or nil when nothing is queued. Never refuses.
    def poll: () -> Notification?
    # At most `max` queued notifications, oldest first. Never refuses.
    def drain: (Integer max) -> Array[Notification]
    def age: (Integer key, Integer now) -> Integer?
    def state: (Integer key, Integer now) -> state?
    def stale_if_error: (Integer key, Integer now) -> Integer?
    def leading: (Integer key) -> Integer?
    def flight: (Integer lease) -> Integer?
    def now: () -> Integer
    # Keys with metadata (the core's `len`).
    def size: () -> Integer
    # Whether no key has metadata (the core's `is_empty`).
    def empty?: () -> bool
    def in_flight: () -> Integer
    def waiting: () -> Integer
    def pending: () -> Integer
    def capacity: () -> Integer
    def flight_capacity: () -> Integer
    def waiter_capacity: () -> Integer
  end
end
